# ==============================================================================
# FitVision AI - Environment Configuration Template (.env.example)
# DO NOT COMMIT THE ACTUAL .env FILE CONTAINING PRIVATE KEYS TO GITHUB OR ZIP!
# ==============================================================================

# 1. Server Configuration
PORT=5050
HOST=0.0.0.0
NODE_ENV=production

# 2. Vision-Language Model API Keys (Gemini Vision fallback)
# Obtain a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Local VLM Fallback (Ollama Moondream)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=moondream

# 4. Frontend Environment Variables (in frontend/.env)
REACT_APP_FOOD_SERVER_URL=http://localhost:5050
CI=false
NODE_OPTIONS=--openssl-legacy-provider
